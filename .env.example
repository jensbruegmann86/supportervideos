# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Storage bucket used for uploaded participant videos
SUPABASE_VIDEO_BUCKET=videos

# Admin backend login (dashboard.php replacement)
# Generate a bcrypt-like hash is not needed: this is a plain secret compared server-side only.
ADMIN_PASSWORD=change-me
# Random long string used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-too-please-32-chars-min

# Participant import source (raceresult.com CSV export), used by /api/participants/import
PARTICIPANTS_CSV_URL=https://api.raceresult.com/300956/76RPSFGMPMH4IONMJ7M6WWXWYRI71A6G
# Shared secret required as ?key= to trigger the import job / timing webhook
IMPORT_JOB_SECRET=change-me
TIMING_WEBHOOK_SECRET=change-me
# Optional: set this to enable Vercel Cron -> /api/participants/import (see vercel.json)
CRON_SECRET=change-me

# Upload validation limits (server-side)
MAX_UPLOAD_MB=30
MAX_UPLOAD_SECONDS=8
# Same limits exposed to the browser for client-side pre-checks
NEXT_PUBLIC_MAX_UPLOAD_MB=30
NEXT_PUBLIC_MAX_UPLOAD_SECONDS=8

# Delay (seconds) before screen 2 plays the same video as screen 1 (~30m course offset)
SCREEN2_DELAY_SECONDS=8
